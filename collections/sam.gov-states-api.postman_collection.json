          "id": "053e1bf1-8df0-4f74-830f-aea59feb4d2c",
          "name": "Get List of States and Provinces",
          "request": {
            "name": "Get List of States and Provinces",
            "description": {
              "content": "Retrieve a list of states, provinces, and subdivisions for both the United States and foreign countries. Supports searching by state/province name or code. Used to validate state data submitted to SAM.gov.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "locationservices",
                "v1",
                "states"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) SAM.gov Federal Government System Account API key"
                },
                {
                  "disabled": false,
                  "key": "cc",
                  "value": "<string>",
                  "description": "Country code (ISO 3166-1 alpha-2, e.g. US for United States)"
                },
                {
                  "disabled": false,
                  "key": "searchby",
                  "value": "<string>",
                  "description": "Field to search by (e.g. statename, statecode)"
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "General query string for state name search"
                },
                {
                  "disabled": false,
                  "key": "active",
                  "value": "<string>",
                  "description": "Filter to active states/provinces only (Y/N)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
