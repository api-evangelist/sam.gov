                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) SAM.gov Federal Government System Account API key"
                },
                {
                  "disabled": false,
                  "key": "cc",
                  "value": "<string>",
                  "description": "Country code (ISO 3166-1 alpha-2, e.g. US for United States)"
                },
                {
                  "disabled": false,
                  "key": "searchby",
                  "value": "<string>",
                  "description": "Field to search by (e.g. cityname, citycode)"
                },
                {
                  "disabled": false,
                  "key": "searchvalue",
                  "value": "<string>",
                  "description": "Value to search for"
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "General query string for city name search"
                },
                {
                  "disabled": false,
                  "key": "active",
                  "value": "<string>",
                  "description": "Filter to active cities only (Y/N)"
                },
                {
                  "disabled": false,
                  "key": "citycode",
                  "value": "<string>",
                  "description": "City code to filter by"
                }
              ],
              "variable": []
            },
