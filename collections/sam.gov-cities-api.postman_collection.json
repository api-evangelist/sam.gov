          "request": {
            "name": "Get List of Cities",
            "description": {
              "content": "Retrieve a list of cities for a given country code. Supports searching by city name, active status, and city code filters. Used to validate city data being submitted to SAM.gov.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "locationservices",
                "v1",
                "cities"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
